# ─────────────────────────────────────────────────────────────────────────────
# SourceIQ — environment configuration
# Copy this file to `.env.local` and fill in the values.
# Anything left unset falls back to a SAFE default: no real emails are sent and
# billing/inbound stay in demo mode until explicitly configured.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (REQUIRED) ──────────────────────────────────────────────────────────

# Anthropic API key — powers every agent (orchestrator, scouts, qualifier, …).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string (Neon recommended). The app reads the first of
# DATABASE_URL / POSTGRES_URL / NEON_DATABASE_URL that is set.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public base URL of this deployment — used to build links (unsubscribe, etc.).
# Local: http://localhost:3000   Prod: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Authentication — Clerk (REQUIRED) ────────────────────────────────────────
# Create an app at https://dashboard.clerk.com and copy both keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Email / Outreach (OPTIONAL — off by default) ─────────────────────────────
# The mailer is SAFE-BY-DEFAULT: with OUTREACH_LIVE unset, outreach is drafted
# but NEVER sent. Set all of the following to send real RFIs to suppliers.

# Master safety switch. Must be exactly "true" to send real email. Leave unset
# (or "false") for demo/draft mode, which also simulates supplier replies.
OUTREACH_LIVE=false

# Email provider. Currently supported: "resend".
MAIL_PROVIDER=resend

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_...

# Verified sending identity. The domain must be verified in Resend (SPF/DKIM).
MAIL_FROM=SourceIQ <sourcing@mail.your-domain.com>

# Domain that receives inbound supplier replies. Point its MX at Resend and wire
# the inbound webhook to /api/inbound. Outbound RFIs use Reply-To
# reply+<token>@<this-domain> so replies thread back to the right supplier.
MAIL_INBOUND_DOMAIN=mail.your-domain.com

# Physical postal address shown in the outreach footer. REQUIRED by anti-spam
# law (CAN-SPAM / CASL) for commercial email.
MAIL_POSTAL_ADDRESS=SourceIQ Inc., 123 Example St, San Francisco, CA 94105, USA

# ── Inbound webhook (OPTIONAL) ───────────────────────────────────────────────
# Svix signing secret for the Resend inbound webhook — verifies calls are genuine.
RESEND_WEBHOOK_SECRET=whsec_...

# Escape hatch for local testing: accept unsigned inbound calls. NEVER in prod.
INBOUND_ALLOW_UNSIGNED=false

# ── Billing — Stripe (OPTIONAL — off by default) ─────────────────────────────
# Without these, the subscription gate relies on the free-trial window only.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Agent tuning (OPTIONAL) ──────────────────────────────────────────────────
SCOUT_CONCURRENCY=3       # scouts run concurrently per wave (default 3)
QUAL_CONCURRENCY=4        # suppliers qualified concurrently per scout (default 4)
QUALIFIER_GROUNDING=1     # web-search grounding on the risky band; "0" disables

# ── Local development only ───────────────────────────────────────────────────
# Bypass Clerk auth locally (fake user/org). NEVER set in production.
DEV_AUTH_BYPASS=false
