# ─── SourceIQ environment ───────────────────────────────────────────────────
# Copy to .env.local for development, or set these in your Vercel project.

# ── Core AI ──
# Anthropic API key powering all sourcing / qualification / outreach agents.
ANTHROPIC_API_KEY=sk-ant-...

# ── Database (hosted Postgres, e.g. Neon) ──
# Any ONE of these is used (checked in this order). Use the pooled connection
# string for serverless / Vercel.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# POSTGRES_URL=
# NEON_DATABASE_URL=

# ── Auth (Clerk) ──
# From the Clerk dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional: route overrides (defaults shown).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Billing (Stripe) ──
# Billing is only enforced when BOTH STRIPE_SECRET_KEY and STRIPE_PRICE_ID are
# set. Leave them unset for local dev to keep all features unlocked.
STRIPE_SECRET_KEY=sk_test_...
# Price id of your recurring "Pro" subscription price.
STRIPE_PRICE_ID=price_...
# Signing secret for the webhook endpoint (Stripe dashboard → Webhooks, or the
# value printed by `stripe listen`). Required for the webhook to accept events.
STRIPE_WEBHOOK_SECRET=whsec_...

# Public base URL of the app (used for Stripe success/cancel + portal returns).
# Locally: http://localhost:3000 — on Vercel: your production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email / outreach (Resend) — optional ──
# Without these, outreach runs in DRAFT/simulation mode (no real emails sent).
MAIL_PROVIDER=resend
RESEND_API_KEY=re_...
MAIL_FROM="SourceIQ <sourcing@yourdomain.com>"
MAIL_INBOUND_DOMAIN=reply.yourdomain.com
# Set to "1" to actually send live emails (otherwise draft-only).
OUTREACH_LIVE=0
# Verifies inbound reply webhooks from Resend.
RESEND_WEBHOOK_SECRET=whsec_...
# Dev-only: set "1" to accept unsigned inbound webhook posts.
INBOUND_ALLOW_UNSIGNED=0

# ── Tuning ──
# Max suppliers qualified concurrently per scout agent (default 4).
QUAL_CONCURRENCY=4
